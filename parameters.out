 Adapt {
     list = [ "slope" ];
     max_level = 3;
     slope {
         field_list = [ "density" ];
         max_coarsen = 2.000000000000000;
         min_refine = 10.00000000000000;
         type = "slope";
     };
 }

 Boundary {
     type = "reflecting";
 }

 Domain {
     lower = [ 0.000000000000000, 0.000000000000000 ];
     upper = [ 1.000000000000000, 1.000000000000000 ];
 }

 Field {
     ghost_depth = 4;
     list = [ "density", "velocity_x", "velocity_y", "total_energy", "internal_energy", "pressure" ];
 }

 Group {
     conserved {
         field_list = [ "density", "internal_energy", "total_energy", "velocity_x", "velocity_y" ];
     };
     list = [ "conserved", "make_field_conservative" ];
     make_field_conservative {
         field_list = [ "velocity_x", "velocity_y", "internal_energy", "total_energy" ];
     };
 }

 Initial {
     list = [ "value" ];
     value {
         density = [ 1.000000000000000, ((((((( 0.2000000000000000  <  x ) && ( x  <  0.3000000000000000 )) && ( 0.3000000000000000  <  y )) && ( y  <  0.7000000000000000 )) || (((( 0.4000000000000000  <  x ) && ( x  <  0.5000000000000000 )) && ( 0.3000000000000000  <  y )) && ( y  <  0.7000000000000000 ))) || (((( 0.6000000000000000  <  x ) && ( x  <  0.7000000000000000 )) && ( 0.3000000000000000  <  y )) && ( y  <  0.5000000000000000 ))) || (((( 0.2000000000000000  <  x ) && ( x  <  0.5000000000000000 )) && ( 0.4500000000000000  <  y )) && ( y  <  0.5500000000000000 ))) || (((( x  -  0.6500000000000000 ) * ( x  -  0.6500000000000000 )) + (( y  -  0.6000000000000000 ) * ( y  -  0.6000000000000000 ))) <  0.002500000000000000 ), 0.1250000000000000 ];
         total_energy = [ 2.500000000000000, ((((((( 0.2000000000000000  <  x ) && ( x  <  0.3000000000000000 )) && ( 0.3000000000000000  <  y )) && ( y  <  0.7000000000000000 )) || (((( 0.4000000000000000  <  x ) && ( x  <  0.5000000000000000 )) && ( 0.3000000000000000  <  y )) && ( y  <  0.7000000000000000 ))) || (((( 0.6000000000000000  <  x ) && ( x  <  0.7000000000000000 )) && ( 0.3000000000000000  <  y )) && ( y  <  0.5000000000000000 ))) || (((( 0.2000000000000000  <  x ) && ( x  <  0.5000000000000000 )) && ( 0.4500000000000000  <  y )) && ( y  <  0.5500000000000000 ))) || (((( x  -  0.6500000000000000 ) * ( x  -  0.6500000000000000 )) + (( y  -  0.6000000000000000 ) * ( y  -  0.6000000000000000 ))) <  0.002500000000000000 ), 3.500000000000000 ];
         velocity_x = 0.000000000000000;
         velocity_y = 0.000000000000000;
     };
 }

 Mesh {
     root_blocks = [ 4, 4 ];
     root_rank = 2;
     root_size = [ 80, 80 ];
 }

 Method {
     list = [ "ppm", "flux_correct" ];
     ppm {
         courant = 0.8000000000000000;
         diffusion = true;
         flattening = 3;
         steepening = true;
     };
 }

 Output {
     density {
         colormap = [ "black", "blue", "cyan", "lime", "yellow", "red" ];
         field_list = [ "density" ];
         image_size = [ 640, 640 ];
         image_type = "data";
         name = [ "hi-de-%04d.png", "count" ];
         schedule {
             step = 10;
             var = "cycle";
         };
         type = "image";
     };
     list = [ "density", "mesh_age", "mesh_level" ];
     mesh_age {
         colormap = [ "black", "red", "yellow", "white" ];
         image_max = 1.000000000000000;
         image_mesh_color = "age";
         image_min = 0.000000000000000;
         image_size = [ 641, 641 ];
         image_type = "mesh";
         name = [ "hi-mesh-age-%04d.png", "count" ];
         schedule {
             step = 10;
             var = "cycle";
         };
         type = "image";
     };
     mesh_level {
         colormap = [ "black", "blue", "cyan", "lime", "yellow", "red" ];
         image_mesh_color = "level";
         image_size = [ 641, 641 ];
         image_type = "mesh";
         name = [ "hi-mesh-level-%04d.png", "count" ];
         schedule {
             step = 10;
             var = "cycle";
         };
         type = "image";
     };
 }

 Physics {
     fluid_props {
         dual_energy {
             type = "disabled";
         };
         eos {
             gamma = 1.400000000000000;
             type = "ideal";
         };
     };
     list = [ "fluid_props" ];
 }

 Stopping {
     time = 0.1000000000000000;
 }
