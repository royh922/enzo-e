 Boundary {
     type = "periodic";
 }

 Domain {
     lower = [ 0.000000000000000, 0.000000000000000, 0.000000000000000 ];
     upper = [ 3.000000000000000, 1.500000000000000, 1.500000000000000 ];
 }

 Field {
     alignment = 8;
     courant = 0.4000000000000000;
     ghost_depth = 3;
     list = [ "density", "velocity_x", "velocity_y", "velocity_z", "total_energy", "pressure" ];
     padding = 0;
 }

 Group {
     derived {
         field_list = [ "pressure" ];
     };
     list = [ "derived" ];
 }

 Initial {
     inclined_wave {
         alpha = 0.7297276562269663;
         amplitude = 1.000000000000000e-06;
         beta = 1.107148717794090;
         lambda = 1.000000000000000;
         positive_vel = true;
         wave_type = "hd_entropy";
     };
     list = [ "inclined_wave" ];
 }

 Mesh {
     root_blocks = [ 2, 2, 2 ];
     root_rank = 3;
     root_size = [ 64, 32, 32 ];
 }

 Method {
     list = [ "mhd_vlct" ];
     mhd_vlct {
         courant = 0.4000000000000000;
         mhd_choice = "no_bfield";
         reconstruct_method = "plm";
         riemann_solver = "hllc";
         theta_limiter = 2.000000000000000;
         time_scheme = "vl";
         viscosity_nu = 0.1000000000000000;
     };
 }

 Output {
     data {
         dir = [ "method_vlct-1-hd_entropyN32_%.1f", "time" ];
         field_list = [ "density", "velocity_x", "velocity_y", "velocity_z", "pressure", "total_energy" ];
         name = [ "data-%03d.h5", "proc" ];
         schedule {
             list = [ 0.000000000000000, 1.000000000000000 ];
             var = "time";
         };
         type = "data";
     };
     list = [ "data" ];
 }

 Physics {
     fluid_props {
         eos {
             gamma = 1.666666666666667;
         };
         floors {
             density = 1.000000000000000e-200;
             pressure = 1.000000000000000e-200;
         };
     };
     list = [ "fluid_props" ];
 }

 Stopping {
     time = 1.000000000000000;
 }
