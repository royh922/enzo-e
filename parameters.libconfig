 Boundary : {
     list = ( "outflow", "periodic" );
     outflow : {
         axis = "z";
         type = "outflow";
     };
     periodic : {
         axis = "x";
         type = "periodic";
     };
 }

 Domain : {
     lower = ( -16.00000000000000, -16.00000000000000, -16.00000000000000 );
     upper = ( 16.00000000000000, 16.00000000000000, 16.00000000000000 );
 }

 Field : {
     ghost_depth = 4;
     list = ( "density", "pressure", "velocity_x", "velocity_y", "velocity_z", "total_energy", "internal_energy" );
 }

 Initial : {
     kelvin_helmholtz : {
         M_b = 1.000000000000000;
         density_contrast = 100.0000000000000;
         lambda_pert = 1.000000000000000;
         n_0 = 0.01000000000000000;
         noisy_ic = false;
         pert_loc = 0.000000000000000;
         radius = 3.000000000000000;
         random_seed = 12345;
         temperature = 15000.00000000000;
         vel_pert = 0.01000000000000000;
     };
     list = ( "kelvin_helmholtz" );
 }

 Mesh : {
     root_blocks = ( 8, 8, 8 );
     root_rank = 3;
     root_size = ( 256, 256, 256 );
 }

 Method : {
     list = ( "ppm" );
     ppm : {
         courant = 0.8000000000000000;
         diffusion = true;
         flattening = 3;
         steepening = true;
     };
 }

 Monitor : {
     debug = false;
     verbose = true;
 }

 Output : {
     hdf5 : {
         dir = ( "KH-%04d", "count" );
         field_list = ( "density", "velocity_x", "velocity_y", "velocity_z", "total_energy" );
         name = ( "KH-%02d-%02d.h5", "proc", "count" );
         schedule : {
             step = 25;
             var = "cycle";
         };
         type = "data";
     };
     image : {
         axis = "y";
         colormap = ( "black", "white" );
         dir = "images";
         field_list = ( "density" );
         name = ( "KH%02d.png", "count" );
         schedule : {
             step = 25;
             var = "cycle";
         };
         type = "image";
     };
     list = ( "image", "hdf5" );
 }

 Physics : {
     fluid_props : {
         dual_energy : {
             type = "disabled";
         };
         eos : {
             gamma = 1.666666666667000;
         };
         floors : {
             density = 1.000000000000000e-10;
             pressure = 1.000000000000000e-10;
         };
         mol_weight = 0.6000000000000000;
     };
     list = ( "fluid_props" );
 }

 Stopping : {
     cycle = 1000;
     time = 10.00000000000000;
 }

 Time : {
     time_final = 2.000000000000000;
 }

 Units : {
