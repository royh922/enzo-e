 Adapt : {
     max_level = 0;
     min_level = 0;
 }

 Boundary : {
     list = ( "outflow", "periodic" );
     outflow : {
         axis = "z";
         type = "outflow";
     };
     periodic : {
         axis = "x";
         type = "periodic";
     };
 }

 Domain : {
     lower = ( -16.00000000000000, -16.00000000000000, -16.00000000000000 );
     upper = ( 16.00000000000000, 16.00000000000000, 16.00000000000000 );
 }

 Field : {
     bfieldi_x : {
         centering = ( false, true, true );
     };
     bfieldi_y : {
         centering = ( true, false, true );
     };
     bfieldi_z : {
         centering = ( true, true, false );
     };
     ghost_depth = 4;
     list = ( "density", "velocity_x", "velocity_y", "velocity_z", "total_energy", "bfieldi_x", "bfieldi_y", "bfieldi_z", "bfield_x", "bfield_y", "bfield_z", "pressure" );
 }

 Initial : {
     kelvin_helmholtz : {
         M_b = 1.000000000000000;
         density_contrast = 100.0000000000000;
         n_0 = 0.01000000000000000;
         noisy_ic = false;
         radius = 3.000000000000000;
         random_seed = 12345;
         temperature = 15000.00000000000;
         vel_pert = 0.01000000000000000;
     };
     list = ( "kelvin_helmholtz", "vlct_bfield" );
     vlct_bfield : {
         Ax = ( 0.000000000000000 );
         Ay = ( " -0.2450980390625000  *  z " );
         Az = ( " 0.2450980390625000  *  y " );
         update_etot = true;
     };
 }

 Mesh : {
     root_blocks = ( 2, 2, 2 );
     root_rank = 3;
     root_size = ( 128, 128, 128 );
 }

 Method : {
     check : {
         dir = ( "check-%02d", "cycle" );
         include_ghosts = false;
         num_files = 8;
         ordering = "order_morton";
         schedule : {
             start = 100;
             step = 500;
             var = "cycle";
         };
     };
     list = ( "mhd_vlct" );
     mhd_vlct : {
         courant = 0.4000000000000000;
         mhd_choice = "constrained_transport";
         reconstruct_method = "plm";
         riemann_solver = "hlld";
         theta_limiter = 2.000000000000000;
         time_scheme = "vl";
     };
     order_morton : {
         schedule : {
             start = 100;
             step = 500;
             var = "cycle";
         };
     };
     ppm : {
         courant = 0.8000000000000000;
         diffusion = true;
         flattening = 3;
         steepening = true;
     };
 }

 Monitor : {
     debug = false;
     verbose = true;
 }

 Output : {
     hdf5 : {
         dir = ( "KH-MHD-%04d", "count" );
         field_list = ( "density", "velocity_x", "velocity_y", "velocity_z", "total_energy", "bfield_x", "bfield_y", "bfield_z" );
         name = ( "KH-MHD-%02d-%02d.h5", "proc", "count" );
         schedule : {
             start = 0.000000000000000;
             step = 3.000000000000000;
             var = "time";
         };
         type = "data";
     };
     image : {
         axis = "y";
         colormap = ( "black", "white" );
         dir = "MHD";
         field_list = ( "density" );
         name = ( "KH-MHD%02d.png", "count" );
         schedule : {
             start = 0.000000000000000;
             step = 3.000000000000000;
             var = "time";
         };
         type = "image";
     };
     list = ( "image", "hdf5" );
 }

 Physics : {
     fluid_props : {
         dual_energy : {
             type = "disabled";
         };
         eos : {
             gamma = 1.666666666667000;
             type = "ideal";
         };
         floors : {
             density = 1.000000000000000e-10;
             pressure = 1.000000000000000e-10;
         };
         mol_weight = 0.6000000000000000;
     };
     list = ( "fluid_props" );
 }

