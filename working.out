 Adapt {
     list = [ "mass_baryon", "mass_dark" ];
     mass_baryon {
         field_list = [ "density" ];
         mass_type = "baryon";
         max_coarsen = 0.1250000000000000;
         min_refine = 8.000000000000000;
         type = "mass";
     };
     mass_dark {
         field_list = [ "density_particle_accumulate" ];
         mass_type = "dark";
         max_coarsen = 0.1250000000000000;
         min_refine = 8.000000000000000;
         type = "mass";
     };
     max_initial_level = 0;
     max_level = 4;
     min_level = -2;
 }

 Balance {
     start = 10;
     value = 20;
     var = "cycle";
 }

 Boundary {
     type = "periodic";
 }

 Domain {
     lower = [ 0.000000000000000, 0.000000000000000, 0.000000000000000 ];
     upper = [ 1.000000000000000, 1.000000000000000, 1.000000000000000 ];
 }

 Field {
     alignment = 8;
     gamma = 1.666700000000000;
     ghost_depth = 4;
     history = 1;
     list = [ "density", "velocity_x", "velocity_y", "velocity_z", "acceleration_x", "acceleration_y", "acceleration_z", "total_energy", "internal_energy", "pressure", "density_total", "density_particle", "density_particle_accumulate", "potential", "density_gas", "X_copy", "B" ];
     padding = 0;
 }

 Initial {
     hdf5 {
         FD {
             dataset = "GridDensity";
             file = "input/cosmo_grid_density.h5";
             name = "density";
             type = "field";
         };
         FVX {
             dataset = "GridVelocities_x";
             file = "input/cosmo_grid_velocities_x.h5";
             name = "velocity_x";
             type = "field";
         };
         FVY {
             dataset = "GridVelocities_y";
             file = "input/cosmo_grid_velocities_y.h5";
             name = "velocity_y";
             type = "field";
         };
         FVZ {
             dataset = "GridVelocities_z";
             file = "input/cosmo_grid_velocities_z.h5";
             name = "velocity_z";
             type = "field";
         };
         PVX {
             attribute = "vx";
             dataset = "ParticleVelocities_x";
             file = "input/cosmo_particle_velocities_x.h5";
             name = "dark";
             type = "particle";
         };
         PVY {
             attribute = "vy";
             dataset = "ParticleVelocities_y";
             file = "input/cosmo_particle_velocities_y.h5";
             name = "dark";
             type = "particle";
         };
         PVZ {
             attribute = "vz";
             dataset = "ParticleVelocities_z";
             file = "input/cosmo_particle_velocities_z.h5";
             name = "dark";
             type = "particle";
         };
         PX {
             attribute = "x";
             dataset = "ParticleDisplacements_x";
             file = "input/cosmo_particle_displacements_x.h5";
             name = "dark";
             type = "particle";
         };
         PY {
             attribute = "y";
             dataset = "ParticleDisplacements_y";
             file = "input/cosmo_particle_displacements_y.h5";
             name = "dark";
             type = "particle";
         };
         PZ {
             attribute = "z";
             dataset = "ParticleDisplacements_z";
             file = "input/cosmo_particle_displacements_z.h5";
             name = "dark";
             type = "particle";
         };
         blocking = [ 2, 4, 1 ];
         file_list = [ "FD", "FVX", "FVY", "FVZ", "PX", "PY", "PZ", "PVX", "PVY", "PVZ" ];
         format = "music";
         monitor_iter = 1;
     };
     list = [ "hdf5", "cosmology" ];
     new = true;
 }

 Mesh {
     root_blocks = [ 4, 4, 4 ];
     root_rank = 3;
     root_size = [ 32, 32, 32 ];
 }

 Method {
     check {
         dir = [ "Check-%02d", "cycle" ];
         num_files = 4;
         ordering = "order_morton";
         schedule {
             list = [ 140 ];
             var = "cycle";
         };
     };
     gravity {
         accumulate = true;
         order = 2;
         solver = "dd";
     };
     list = [ "order_morton", "check", "debug", "pm_deposit", "gravity", "pm_update", "comoving_expansion" ];
     order_morton {
         schedule {
             list = [ 140 ];
             var = "cycle";
         };
     };
     ppm {
         courant = 0.5000000000000000;
         diffusion = false;
         dual_energy = true;
     };
 }

 Output {
     ax {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "acceleration_x" ];
         image_ghost = false;
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "ax-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     ay {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "acceleration_y" ];
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "ay-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     az {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "acceleration_z" ];
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "az-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     dark {
         colormap = [ "black", "red", "yellow", "white" ];
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         image_ghost = false;
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "dark-%02d.png", "count" ];
         particle_list = [ "dark" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     de {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "density" ];
         image_ghost = false;
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "de-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     dep {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "density_particle" ];
         image_ghost = false;
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "dep-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     depa {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "density_particle_accumulate" ];
         image_ghost = false;
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "depa-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     hdf5 {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "density", "velocity_x", "velocity_y", "velocity_z", "acceleration_x", "acceleration_y", "acceleration_z", "total_energy", "internal_energy", "pressure" ];
         name = [ "data-%02d-%02d.h5", "count", "proc" ];
         particle_list = [ "dark" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "data";
     };
     list = [ "de", "depa", "ax", "dark", "mesh", "po", "hdf5" ];
     mesh {
         colormap = [ "black", "blue", "cyan", "lime", "yellow", "red" ];
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         image_reduce_type = "max";
         image_size = [ 513, 513 ];
         image_type = "mesh";
         name = [ "mesh-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
     po {
         dir = [ "Dir_COSMO_DD_%04d", "cycle" ];
         field_list = [ "potential" ];
         image_size = [ 512, 512 ];
         image_type = "data";
         name = [ "po-%02d.png", "count" ];
         schedule {
             step = 20;
             var = "cycle";
         };
         type = "image";
     };
 }

 Particle {
     dark {
         attributes = [ "x", "default", "y", "default", "z", "default", "vx", "default", "vy", "default", "vz", "default", "ax", "default", "ay", "default", "az", "default", "is_local", "default" ];
         constants = [ "mass", "default", 2.644856770833435e-05 ];
         group_list = [ "is_gravitating" ];
         mass_is_mass = true;
         position = [ "x", "y", "z" ];
         velocity = [ "vx", "vy", "vz" ];
     };
     list = [ "dark" ];
 }

 Physics {
     cosmology {
         comoving_box_size = 3.000000000000000;
         final_redshift = 3.000000000000000;
         hubble_constant_now = 0.7000000000000000;
         initial_redshift = 99.00000000000000;
         max_expansion_rate = 0.01500000000000000;
         omega_baryon_now = 0.04000000000000000;
         omega_cdm_now = 0.2600000000000000;
         omega_lambda_now = 0.7000000000000000;
         omega_matter_now = 0.3000000000000000;
     };
     list = [ "cosmology", "gravity" ];
 }

 Solver {
     dd {
         coarse_level = 0;
         coarse_solve = "dd_root";
         domain_solve = "dd_domain";
         last_smooth = "dd_smooth";
         max_level = 4;
         min_level = -2;
         monitor_iter = 1;
         type = "dd";
     };
     dd_domain {
         coarse_level = 0;
         iter_max = 100;
         max_level = 4;
         min_level = -2;
         monitor_iter = 0;
         res_tol = 0.1000000000000000;
         solve_type = "tree";
         type = "bicgstab";
     };
     dd_root {
         coarse_level = -2;
         coarse_solve = "root_coarse";
         iter_max = 2;
         max_level = 0;
         min_level = -2;
         monitor_iter = 1;
         post_smooth = "root_post";
         pre_smooth = "root_pre";
         res_tol = 0.05000000000000000;
         solve_type = "level";
         type = "mg0";
     };
     dd_smooth {
         iter_max = 1;
         monitor_iter = 1;
         solve_type = "leaf";
         type = "jacobi";
     };
     list = [ "dd", "dd_root", "dd_domain", "dd_smooth", "root_coarse", "root_pre", "root_post" ];
     root_coarse {
         iter_max = 100;
         monitor_iter = 1;
         res_tol = 0.1000000000000000;
         solve_type = "block";
         type = "cg";
     };
     root_post {
         iter_max = 2;
         solve_type = "level";
         type = "jacobi";
     };
     root_pre {
         iter_max = 2;
         solve_type = "level";
         type = "jacobi";
     };
 }

 Stopping {
     cycle = 160;
 }
